#!/usr/bin/env bash
#
# The theme carousel: a standalone Quickshell window, owned by no desktop.
# RISO_CAROUSEL_APPLY names the command a selection runs; it defaults to
# riso's own apply.

set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

case "${1:-themes}" in
  themes)
    export RISO_CAROUSEL_LIST="$here/list-themes.sh"
    export RISO_CAROUSEL_APPLY="${RISO_CAROUSEL_APPLY:-riso set}"
    export RISO_CAROUSEL_CURRENT="cat \"\${XDG_STATE_HOME:-\$HOME/.local/state}/riso/current/theme.name\""
    ;;
  backgrounds)
    export RISO_CAROUSEL_LIST="$here/list-backgrounds.sh"
    export RISO_CAROUSEL_APPLY="${RISO_CAROUSEL_APPLY_BG:-$here/set-background.sh}"
    export RISO_CAROUSEL_CURRENT="readlink -f \"\${XDG_STATE_HOME:-\$HOME/.local/state}/riso/current/background\""
    ;;
  *)
    echo "usage: riso-carousel [themes|backgrounds]" >&2
    exit 1
    ;;
esac

exec quickshell -n -p "$here"
